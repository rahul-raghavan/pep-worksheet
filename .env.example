# Google OAuth web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Local: http://localhost:3000
# Production: https://your-production-domain.example
NEXTAUTH_URL=http://localhost:3000

# Optional comma-separated access overrides
ALLOWED_EMAIL_DOMAINS=pepschoolv2.com,accelschool.in
ALLOWED_EMAILS=

# Private download-tracker access (server-enforced)
PRIVATE_ADMIN_EMAILS=rahul@pepschoolv2.com

# Supabase project used only for privacy-minimal usage events
# SUPABASE_URL may also be supplied as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local Chrome/Chromium executable override
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
